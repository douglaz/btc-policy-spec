import BtcPolicy.Encode
/-! `MAN-2`'s manifest preimage, revision 4: "with `WIR-18`'s
little-endian encoder, exactly" the field list below; `manifest_hash` is the tagged hash over
these bytes and stays `check_vectors.py`'s. Two things are computed rather than copied: the
allowlist is "the node's allowlist MINUS the escape descriptor, each rendered by `MAN-39`,
sorted, deduplicated", and the nodes go "in `node_id` order". Descriptors enter as their
rendered bytes (`MAN-39`'s rendering and checksum are `vector_profiles.py`'s).

`MAN-3`: "`protocol_version` is the manifest schema revision, currently `4` … No vault was ever
sealed at revision 1, 2 or 3 … an implementation MUST refuse them outright rather than carry
encoders for them." So `encode` is defined at revision 4 and refuses every other value; there
is no encoder for 1, 2 or 3 here to be wrong. -/

namespace BtcPolicy.Manifest
open BtcPolicy.Encode

structure Node where
  nodeId : Nat
  signingPubkey : Bytes
  channelPubkey : Bytes
  endpoints : List Bytes
  deriving DecidableEq, Repr

/-- The sealed fields, as configured: the allowlist as the node holds it (any order, duplicates,
the escape possibly among them) and the nodes in any order. `body` canonicalizes both. -/
structure Manifest where
  walletId : Bytes
  protocolVersion : Nat
  coordinatorAuthPubkey : Bytes
  maxMsgBytes : Nat
  hotMaxPerTx : Nat
  hotMaxPerWindow : Nat
  hotWindowSecs : Nat
  hotAllowlist : List Bytes
  escapeDescriptor : Bytes
  maxDerivationIndex : Nat
  escapeFeerateFloor : Nat
  escapeCoveragePct : Nat
  escapeBumpMaxFeePct : Nat
  network : Nat
  policyVersion : Nat
  refreshMinIntervalSecs : Nat
  refreshMaxFeerate : Nat
  nodes : List Node
  deriving DecidableEq, Repr

/-- Byte-wise lexicographic order: what sorting the rendered UTF-8 strings gives. -/
def lexLe : Bytes → Bytes → Bool
  | [], _ => true
  | _ :: _, [] => false
  | a :: as, b :: bs => a < b || (a == b && lexLe as bs)

/-- Insertion sort, structurally recursive so that `decide` evaluates it (core's `mergeSort` is
well-founded recursion and reduces in neither `decide` nor the kernel). -/
def insert {α : Type} (le : α → α → Bool) (a : α) : List α → List α
  | [] => [a]
  | b :: bs => if le a b then a :: b :: bs else b :: insert le a bs

def isort {α : Type} (le : α → α → Bool) : List α → List α
  | [] => []
  | a :: as => insert le a (isort le as)

theorem mem_insert {α : Type} (le : α → α → Bool) (x a : α) (l : List α) :
    x ∈ insert le a l ↔ x = a ∨ x ∈ l := by
  induction l with
  | nil => simp [insert]
  | cons b bs ih =>
    simp only [insert]
    split
    · simp
    · simp only [List.mem_cons, ih]
      constructor <;> intro h <;> rcases h with h | h | h <;> simp [h]

theorem mem_isort {α : Type} (le : α → α → Bool) (x : α) (l : List α) :
    x ∈ isort le l ↔ x ∈ l := by
  induction l with
  | nil => simp [isort]
  | cons a as ih => simp [isort, mem_insert, ih]

/-- `MAN-2`: "the node's allowlist MINUS the escape descriptor … sorted, deduplicated". -/
@[req "MAN-2"]
def canonAllowlist (hot : List Bytes) (escape : Bytes) : List Bytes :=
  isort lexLe (hot.filter (· != escape)).eraseDups

/-- `MAN-2`: "per node in `node_id` order". -/
@[req "MAN-2"]
def sortNodes (nodes : List Node) : List Node := isort (fun a b => decide (a.nodeId ≤ b.nodeId)) nodes

/-- `MAN-3`: "currently `4`". -/
@[req "MAN-3"] def revision : Nat := 4

@[req "MAN-2"]
def encNode (n : Node) : Bytes :=
  u16 n.nodeId ++ fixed n.signingPubkey ++ fixed n.channelPubkey ++ list n.endpoints

/-- `MAN-2`'s field list in order, the allowlist and the nodes canonicalized. -/
@[req "MAN-2"]
def body (m : Manifest) : Bytes :=
  fixed m.walletId ++ u32 m.protocolVersion ++ fixed m.coordinatorAuthPubkey ++
  u64 m.maxMsgBytes ++ u64 m.hotMaxPerTx ++ u64 m.hotMaxPerWindow ++ u64 m.hotWindowSecs ++
  list (canonAllowlist m.hotAllowlist m.escapeDescriptor) ++ var m.escapeDescriptor ++
  u32 m.maxDerivationIndex ++ u64 m.escapeFeerateFloor ++ u8 m.escapeCoveragePct ++
  u8 m.escapeBumpMaxFeePct ++ u8 m.network ++ u32 m.policyVersion ++
  u64 m.refreshMinIntervalSecs ++ u64 m.refreshMaxFeerate ++
  u32 (sortNodes m.nodes).length ++ (sortNodes m.nodes).flatMap encNode

/-- `MAN-3`'s refusal comes first: a manifest at any revision but 4 has no preimage. -/
@[req "MAN-3"]
def encode (m : Manifest) : Option Bytes :=
  if m.protocolVersion = revision then some (body m) else none

/-- The canonical form `body` writes: what a decoder can give back. -/
def normalize (m : Manifest) : Manifest :=
  { m with hotAllowlist := canonAllowlist m.hotAllowlist m.escapeDescriptor, nodes := sortNodes m.nodes }

def decNode (bs : Bytes) : Option (Node × Bytes) := do
  let (nodeId, bs) ← readLE 2 bs
  let (signingPubkey, bs) ← takeN 33 bs
  let (channelPubkey, bs) ← takeN 33 bs
  let (endpoints, bs) ← readList bs
  pure ({ nodeId, signingPubkey, channelPubkey, endpoints }, bs)

/-- The decoder, refusing any revision but 4 "before any other schema check" (`MAN-3`), and
consuming the whole string. -/
@[req "MAN-2"]
def decode (bs : Bytes) : Option Manifest := do
  let (walletId, bs) ← takeN 32 bs
  let (protocolVersion, bs) ← readLE 4 bs
  if protocolVersion = revision then
    let (coordinatorAuthPubkey, bs) ← takeN 33 bs
    let (maxMsgBytes, bs) ← readLE 8 bs
    let (hotMaxPerTx, bs) ← readLE 8 bs
    let (hotMaxPerWindow, bs) ← readLE 8 bs
    let (hotWindowSecs, bs) ← readLE 8 bs
    let (hotAllowlist, bs) ← readList bs
    let (escapeDescriptor, bs) ← readVar bs
    let (maxDerivationIndex, bs) ← readLE 4 bs
    let (escapeFeerateFloor, bs) ← readLE 8 bs
    let (escapeCoveragePct, bs) ← readLE 1 bs
    let (escapeBumpMaxFeePct, bs) ← readLE 1 bs
    let (network, bs) ← readLE 1 bs
    let (policyVersion, bs) ← readLE 4 bs
    let (refreshMinIntervalSecs, bs) ← readLE 8 bs
    let (refreshMaxFeerate, bs) ← readLE 8 bs
    let (k, bs) ← readLE 4 bs
    let (nodes, bs) ← readN decNode k bs
    match bs with
    | [] => pure { walletId, protocolVersion, coordinatorAuthPubkey, maxMsgBytes, hotMaxPerTx,
                   hotMaxPerWindow, hotWindowSecs, hotAllowlist, escapeDescriptor,
                   maxDerivationIndex, escapeFeerateFloor, escapeCoveragePct, escapeBumpMaxFeePct,
                   network, policyVersion, refreshMinIntervalSecs, refreshMaxFeerate, nodes }
    | _ => none
  else none

abbrev Node.WF (n : Node) : Prop :=
  n.nodeId < 256 ^ 2 ∧ n.signingPubkey.length = 33 ∧ n.channelPubkey.length = 33 ∧
  n.endpoints.length < 256 ^ 4 ∧ ∀ e ∈ n.endpoints, e.length < 256 ^ 4

/-- The admitted domain, stated on the canonical lists `body` writes. -/
abbrev WF (m : Manifest) : Prop :=
  m.walletId.length = 32 ∧ m.protocolVersion < 256 ^ 4 ∧ m.coordinatorAuthPubkey.length = 33 ∧
  m.maxMsgBytes < 256 ^ 8 ∧ m.hotMaxPerTx < 256 ^ 8 ∧ m.hotMaxPerWindow < 256 ^ 8 ∧
  m.hotWindowSecs < 256 ^ 8 ∧
  (canonAllowlist m.hotAllowlist m.escapeDescriptor).length < 256 ^ 4 ∧
  (∀ b ∈ canonAllowlist m.hotAllowlist m.escapeDescriptor, b.length < 256 ^ 4) ∧
  m.escapeDescriptor.length < 256 ^ 4 ∧ m.maxDerivationIndex < 256 ^ 4 ∧
  m.escapeFeerateFloor < 256 ^ 8 ∧ m.escapeCoveragePct < 256 ∧ m.escapeBumpMaxFeePct < 256 ∧
  m.network < 256 ∧ m.policyVersion < 256 ^ 4 ∧ m.refreshMinIntervalSecs < 256 ^ 8 ∧
  m.refreshMaxFeerate < 256 ^ 8 ∧ (sortNodes m.nodes).length < 256 ^ 4 ∧
  ∀ n ∈ sortNodes m.nodes, n.WF

theorem readLE_u8 (v : Nat) (rest : Bytes) : readLE 1 (v :: rest) = some (v, rest) := by
  simp [readLE, takeN, leVal]

theorem readN_enc_nil {α : Type} (p : Bytes → Option (α × Bytes)) (enc : α → Bytes) (xs : List α)
    (h : ∀ x ∈ xs, ∀ r, p (enc x ++ r) = some (x, r)) :
    readN p xs.length (xs.flatMap enc) = some (xs, []) := by
  simpa using readN_enc p enc xs h []

theorem decNode_enc (n : Node) (h : n.WF) (rest : Bytes) : decNode (encNode n ++ rest) = some (n, rest) := by
  obtain ⟨h1, h2, h3, h4, h5⟩ := h
  simp [decNode, encNode, fixed, u16, List.append_assoc, readLE_le 2 _ h1, takeN_append' h2,
    takeN_append' h3, readList_list _ h4 h5]

/-- On the admitted domain the preimage reads back as the canonical form. -/
@[req "MAN-2"]
theorem decode_body (m : Manifest) (h : WF m) (hv : m.protocolVersion = revision) :
    decode (body m) = some (normalize m) := by
  obtain ⟨hw, -, hck, h1, h2, h3, h4, hal, hab, hes, hmdi, heff, -, -, -, hpol, hrmi,
    hrmf, hnl, hn⟩ := h
  simp [decode, body, normalize, fixed, u32, u64, u8, List.append_assoc, takeN_append' hw,
    hv, readLE_le 4 revision (by decide), takeN_append' hck, readLE_le 8 _ h1, readLE_le 8 _ h2, readLE_le 8 _ h3,
    readLE_le 8 _ h4, readList_list _ hal hab, readVar_var _ hes, readLE_le 4 _ hmdi,
    readLE_le 8 _ heff, readLE_u8, readLE_le 4 _ hpol,
    readLE_le 8 _ hrmi, readLE_le 8 _ hrmf, readLE_le 4 _ hnl,
    readN_enc_nil decNode encNode (sortNodes m.nodes) (fun n hn' r => decNode_enc n (hn n hn') r)]

/-- Two well-formed manifests with one preimage have one canonical form. -/
@[req "MAN-2"]
theorem body_injective (a b : Manifest) (ha : WF a) (hb : WF b)
    (hva : a.protocolVersion = revision) (hvb : b.protocolVersion = revision)
    (h : body a = body b) : normalize a = normalize b := by
  have := decode_body a ha hva
  rw [h, decode_body b hb hvb] at this
  exact (Option.some.inj this).symm

/-- `MAN-2`: the escape descriptor is never in the hashed allowlist, whatever the node holds. -/
@[req "MAN-2"]
theorem escape_not_in_allowlist (hot : List Bytes) (escape : Bytes) :
    escape ∉ canonAllowlist hot escape := by
  simp [canonAllowlist, mem_isort, List.mem_eraseDups, List.mem_filter]

/-- `MAN-3`: a manifest at any revision but 4 has no preimage; 1, 2 and 3 in particular. -/
@[req "MAN-3"]
theorem encode_refuses_other_revisions (m : Manifest) (h : m.protocolVersion ≠ revision) :
    encode m = none := by simp [encode, h]

@[req "MAN-3"]
theorem revisions_1_to_3_refused (m : Manifest) :
    ∀ v ∈ [1, 2, 3], encode { m with protocolVersion := v } = none := by
  simp [encode, revision]

